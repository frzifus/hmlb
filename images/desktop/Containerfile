# age-plugin-yubikey is not packaged in Fedora, and upstream (str4d) ships no
# Fedora package or COPR: https://github.com/str4d/age-plugin-yubikey
# Build v0.5.1 from upstream crates.io source. The Fedora "rustup" package only
# ships rustup-init (no rustup/cargo binary), so bootstrap a throwaway stable
# toolchain into /tmp via rustup-init, build the plugin, then delete the
# toolchain so no compiler is left in the image. The binary is installed to
# /usr/bin, NOT /usr/local: on ostree /usr/local is a symlink to /var, which is
# not part of the image (same reason Bitwarden is relocated to /usr/lib above).
# Everything is in one RUN, so the toolchain + build artifacts are created and
# deleted in the same layer (no image bloat). pcsc-lite-devel is build-only and
# removed afterwards; runtime libpcsclite comes from the kept pcsc-lite package.
# Runtime needs the pcscd daemon (pcsc-lite), socket-activated below. The FIDO2
# SSH path (ssh-keygen -t ed25519-sk) uses libfido2/CTAP directly, not pcscd.
RUN dnf install -y pcsc-lite-devel && \
    export CARGO_HOME=/tmp/cargo-home RUSTUP_HOME=/tmp/rustup-home && \
    /usr/bin/rustup-init -y --profile minimal --no-modify-path \
        --default-toolchain stable --default-host x86_64-unknown-linux-gnu && \
    export PATH="$CARGO_HOME/bin:$PATH" && \
    cargo install --locked --version 0.5.1 --root /tmp/apy-install age-plugin-yubikey && \
    install -m 0755 /tmp/apy-install/bin/age-plugin-yubikey /usr/bin/age-plugin-yubikey && \
    rm -rf "$CARGO_HOME" "$RUSTUP_HOME" /tmp/apy-install && \
    dnf remove -y pcsc-lite-devel

RUN systemctl enable pcscd.socket

# --- doom emacs: bake pinned core + user config into /etc/skel ---------------
# /usr is read-only at runtime on ostree, but doom must write to $EMACSDIR/.local
# (straight packages, eln-cache, env snapshot). The tree therefore lives in
# /etc/skel: useradd copies it into a writable $HOME at account creation.
# The pin matches the commit deployed on the host (upstream master as of 2026-01).
# reset --hard keeps master checked out, so a later `doom upgrade` (git pull)
# still fast-forwards instead of dying on a detached HEAD.
RUN git clone https://github.com/doomemacs/doomemacs /etc/skel/.config/emacs && \
    git -C /etc/skel/.config/emacs reset --hard 57818a6da90fbef39ff80d62fab2cd319496c3b9

COPY ./etc/skel/ /etc/skel/

# Bootstrap straight, install the pinned packages and native-compile.
# HOME points at the skel tree so doom writes .local there instead of /root.
# `--force` bypasses the interactive sync/compile prompts (required as root).
RUN HOME=/etc/skel /etc/skel/.config/emacs/bin/doom install --force

# Smoke test: doctor exits non-zero on warnings (running as root is one), so
# only hard breakage would be worth failing the build over — hence || true.
RUN HOME=/etc/skel /etc/skel/.config/emacs/bin/doom doctor || true

# --- zsh: bake zplug + declared plugins into skel ------------------------------
# /etc/skel/.zshrc sources $ZPLUG_HOME/init.zsh unconditionally, so zplug must
# exist for every shell start. The plugins declared in .zshrc are installed at
# build time so the first login gets the themed prompt with no network
# round-trip. zplug has no non-interactive flag; </dev/null turns any prompt
# into a hard failure instead of a build hang.
RUN git clone https://github.com/zplug/zplug /etc/skel/.zplug
RUN HOME=/etc/skel zsh -c 'source $HOME/.zshrc && zplug install' </dev/null
# atuin's uuid call during the .zshrc source may leave state under skel; keep
# the tree pristine (per-user state is recreated at runtime in $HOME).
RUN rm -rf /etc/skel/.local/share/atuin /etc/skel/.config/atuin

# --- sshd: root bootstrap access via FIDO2 (sk) keys only ----------------------
# openssh-server ships in the base image; this adds hardening + keys. Root is
# the only guaranteed account on a fresh machine (usernames are unknown at
# image time), so the system key store targets /root via AuthorizedKeysFile.
COPY ./etc/ssh/sshd_config.d/10-sk-only.conf /etc/ssh/sshd_config.d/10-sk-only.conf
COPY ./etc/ssh/authorized_keys.d/root /etc/ssh/authorized_keys.d/root

RUN systemctl enable sshd.service

# --- fold /etc into /usr/etc ---------------------------------------------------
# The silverblue base commit keeps its config directly in /etc (transient /
# overlayfs-root style) and has NO /usr/etc. rpm-ostree's container import
# however remaps every /etc entry of Dockerfile-derived layers into /usr/etc
# (ostree-rs-ext, lib/src/tar/write.rs: "Move /etc to /usr/etc"). Rebasing to
# an image built that way therefore assembles a commit holding the base's
# populated /etc next to the layers' /usr/etc, and staging the deployment
# dies with: "Preparing /etc: tree contains both /etc and /usr/etc".
#
# Folding the finished /etc state into /usr/etc and emptying /etc out makes
# the imported commit /usr/etc-only; libostree then drops the empty /etc and
# generates the deployment's writable /etc from /usr/etc (the standard
# ostree path). resolv.conf/hosts/hostname are podman build-time bind
# mounts, not image content, so they must stay out of the merge.
RUN set -eux -o pipefail; \
    mkdir -p /usr/etc; \
    tar -C /etc -cf - \
      --exclude=./resolv.conf --exclude=./hosts \
      --exclude=./hostname --exclude=./machine-id . \
      | tar -C /usr/etc -xpf -; \
    find /etc -mindepth 1 -depth \
      ! -path /etc/resolv.conf ! -path /etc/hosts \
      ! -path /etc/hostname ! -path /etc/machine-id \
      -exec rm -rf {} +; \
    ls -la /etc
