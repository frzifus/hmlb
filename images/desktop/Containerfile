# npm's default global prefix (/usr/local) is a symlink to /var/usrlocal on
# ostree, and /var is not part of the image (same reason Bitwarden and
# age-plugin-yubikey above avoid /usr/local) — Node's recursive mkdir dies on
# it with ENOTDIR (build exit 236). Install under /usr/lib instead, link the
# CLI shims into /usr/bin, and relocate the npm cache: /root is a symlink
# into /var too (hence "Log files were not written" in the failed build).
# "dnf remove npm" is a silent no-op on F44 — npm ships as the
# nodejs22-npm/-bin subpackages of nodejs. Removing them by glob keeps
# nodejs itself: codex's shim is a node script, only claude's is a
# self-contained native binary.
RUN npm install --global --prefix /usr/lib/npm-global --cache /tmp/npm-cache \
        @anthropic-ai/claude-code @openai/codex && \
    ln -s /usr/lib/npm-global/bin/* /usr/bin/ && \
    dnf remove -y 'nodejs*-npm*' && \
    rm -rf /root/.npm /tmp/npm-cache

COPY ./etc/codex/config.toml /etc/codex/config.toml
COPY ./etc/codex/model-catalogs/klimlive.json /etc/codex/model-catalogs/klimlive.json
COPY ./etc/claude-code/managed-settings.json /etc/claude-code/managed-settings.json
COPY ./etc/profile.d/klimlive-clis.sh /etc/profile.d/klimlive-clis.sh
# NOTE: the sway setup lives per-user now: /etc/skel/.config/sway (config +
