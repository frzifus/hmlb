RUN rpm --import /etc/pki/rpm-gpg/RPM-GPG-KEY-bitwarden
# Bitwarden installs to /opt which is a symlink to /var/opt on ostree;
# /var is not part of the immutable image, so relocate to /usr/lib/bitwarden.
RUN mkdir -p /var/opt/Bitwarden && dnf install -y bitwarden && \
    mv /var/opt/Bitwarden /usr/lib/bitwarden && \
    sed -i 's|/opt/Bitwarden/bitwarden|/usr/lib/bitwarden/bitwarden|' /usr/share/applications/bitwarden.desktop

RUN dnf install -y \
    mesa-libGL-devel \
