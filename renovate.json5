{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  kubernetes: {
    managerFilePatterns: [
      '/clusters/.+\\.yaml$/',
    ],
  },
  flux: {
    managerFilePatterns: [
      '/clusters/.+\\.yaml$/',
    ],
  },
  customManagers: [
    {
      customType: 'regex',
      description: 'Cosign binary version in Tekton task scripts',
      managerFilePatterns: ['/clusters/.+\\.yaml$/'],
      matchStrings: [
        'COSIGN_VERSION="(?<currentValue>v[^"]+)"',
      ],
      depNameTemplate: 'sigstore/cosign',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v(?<version>.*)$',
    },
    {
      customType: 'regex',
      description: 'FlightCtl OS image references',
      managerFilePatterns: ['/clusters/.+\\.yaml$/'],
      matchStrings: [
        'image: (?<depName>ghcr\\.io/frzifus/[^:]+):(?<currentValue>\\d{4}-\\d{2}-\\d{2})',
      ],
      datasourceTemplate: 'docker',
      versioningTemplate: 'loose',
    },
    {
      customType: 'regex',
      description: 'Talos version in talconfig',
      managerFilePatterns: ['/infra/talconfig\\.yaml$/'],
      matchStrings: [
        'talosVersion: (?<currentValue>v\\S+)',
      ],
      depNameTemplate: 'siderolabs/talos',
      datasourceTemplate: 'github-releases',
    },
  ],
  packageRules: [
    {
      matchPackageNames: ['sigstore/cosign'],
      allowedVersions: '/^v2\\./',
    },
    {
      matchPackageNames: ['quay.io/fedora/fedora-silverblue'],
      allowedVersions: '44',
      automerge: true,
    },
    {
      description: 'Apps: automerge minor/patch/digest updates (exceptions handled below)',
      matchFileNames: ['clusters/homelab/apps/**'],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      excludePackageNames: [
        'jellyfin/jellyfin',
        'immich-app/immich-server',
        'immich-app/immich-machine-learning',
        'cloudnative-pg/postgresql',
        'postgres',
        'paperless-ngx/paperless-ngx',
      ],
      automerge: true,
    },
    {
      description: 'Jellyfin: never automerge (manual review)',
      matchPackageNames: ['jellyfin/jellyfin'],
      automerge: false,
    },
    {
      description: 'Patch-only automerge (z in x.y.z): immich, postgres, paperless',
      matchPackageNames: [
        'immich-app/immich-server',
        'immich-app/immich-machine-learning',
        'cloudnative-pg/postgresql',
        'postgres',
        'paperless-ngx/paperless-ngx',
      ],
      matchUpdateTypes: ['patch'],
      automerge: true,
    },
  ],
}
